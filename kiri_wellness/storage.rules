rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Client profile images
    match /clients/{clientId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Service images
    match /services/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Promotion images
    match /promotions/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Raffle images
    match /raffles/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
